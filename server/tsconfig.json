{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    "module": "commonjs",
    "target": "es2022",
    "rootDir": "./src",
    "outDir": "./dist",
    
    // Other Outputs
    "sourceMap": true,

    // Recommended Options
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
